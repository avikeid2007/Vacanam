<Window x:Class="Vacanam.App.Views.LaunchBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vacanam Launch Banner"
        Width="640" Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Window Entry Scale & Fade Animation -->
            <Storyboard x:Key="WindowLoadAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0.0" To="1.0"
                                 Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="WindowScale"
                                 Storyboard.TargetProperty="ScaleX"
                                 From="0.92" To="1.0"
                                 Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="WindowScale"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="0.92" To="1.0"
                                 Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Progress Countdown Line Animation -->
            <Storyboard x:Key="ProgressAnimation">
                <DoubleAnimation Storyboard.TargetName="ProgressBarScale"
                                 Storyboard.TargetProperty="ScaleX"
                                 From="1.0" To="0.0"
                                 Duration="0:0:3.0"/>
            </Storyboard>

            <!-- Pulsing Status Glow Animation -->
            <Storyboard x:Key="StatusPulseAnimation" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="StatusDot"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1.0" To="0.3"
                                 AutoReverse="True"
                                 Duration="0:0:1.0"/>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer Frame Container -->
    <Border x:Name="MainContainer"
            Background="#12121A"
            BorderBrush="#2B2B42"
            BorderThickness="1"
            CornerRadius="20"
            Padding="0"
            Margin="14"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScale" ScaleX="0.92" ScaleY="0.92"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <!-- Top Ambient Gradient Line -->
            <Border Height="3" VerticalAlignment="Top" CornerRadius="20,20,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#6366F1" Offset="0"/>
                        <GradientStop Color="#A855F7" Offset="0.5"/>
                        <GradientStop Color="#10B981" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Minimalist Centered Layout -->
            <Grid Margin="28,24,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- App Header -->
                    <RowDefinition Height="*"/>      <!-- Center Hotkey Banner -->
                    <RowDefinition Height="Auto"/>   <!-- Footer info -->
                </Grid.RowDefinitions>

                <!-- ══ Header ═════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Glowing Icon -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Ellipse Width="44" Height="44">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#4F46E5" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="🎙"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="VACANAM"
                                       Foreground="#F1F1F8"
                                       FontWeight="Bold"
                                       FontSize="22"/>
                            <Border x:Name="StatusBadge" Background="#10B981" CornerRadius="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#FFFFFF" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TxtBadgeText" Text="READY" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtSubtitle" Text="Instant Local Voice Typing for Windows"
                                   Foreground="#A0A0BC"
                                   FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ══ Prominent Hotkey Banner (Center) ═══════════════════════════════ -->
                <Border Grid.Row="1"
                        Background="#181826"
                        BorderBrush="#2A2A3E"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="0,16,0,16"
                        Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHotkeyTitle" Text="Global Dictation Hotkey"
                                       Foreground="#837AF9"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtHotkeyDesc" Text="Hold key combination to dictate into any active window"
                                       Foreground="#6B6B8A"
                                       FontSize="11"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Keycap Styling -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#222234" BorderBrush="#3B3B56" BorderThickness="1,1,1,2" CornerRadius="6" Padding="12,6">
                                <TextBlock Text="Ctrl" Foreground="#F1F1F8" FontWeight="Bold" FontSize="13"/>
                            </Border>
                            <TextBlock Text="+" Foreground="#6B6B8A" FontSize="14" FontWeight="Bold" Margin="6,0" VerticalAlignment="Center"/>
                            <Border Background="#222234" BorderBrush="#3B3B56" BorderThickness="1,1,1,2" CornerRadius="6" Padding="14,6">
                                <TextBlock Text="Space" Foreground="#10B981" FontWeight="Bold" FontSize="13"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══ Footer ═════════════════════════════════════════════════════════ -->
                <Grid Grid.Row="2" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔒 100% Local &amp; Private • Zero Telemetry"
                                   Foreground="#10B981"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Click or press ESC to dismiss"
                               Foreground="#525270"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Bottom Progress Countdown Indicator -->
            <Border Height="3" VerticalAlignment="Bottom" CornerRadius="0,0,20,20" Background="#1E1E2E">
                <Border x:Name="ProgressBarFill" Background="#6366F1" HorizontalAlignment="Left" Width="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=ActualWidth}">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ProgressBarScale" ScaleX="1.0"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
