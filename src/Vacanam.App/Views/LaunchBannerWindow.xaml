<Window x:Class="Vacanam.App.Views.LaunchBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vacanam — Welcome &amp; Quick Start"
        Width="780" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Window Entry Scale & Fade Animation -->
            <Storyboard x:Key="WindowLoadAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0.0" To="1.0"
                                 Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="WindowScale"
                                 Storyboard.TargetProperty="ScaleX"
                                 From="0.95" To="1.0"
                                 Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="WindowScale"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="0.95" To="1.0"
                                 Duration="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <!-- Pulsing Status Glow Animation -->
            <Storyboard x:Key="StatusPulseAnimation" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="StatusDot"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1.0" To="0.3"
                                 AutoReverse="True"
                                 Duration="0:0:1.0"/>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer Frame Container -->
    <Border x:Name="MainContainer"
            Background="#0D0F18"
            BorderBrush="#252D42"
            BorderThickness="1.5"
            CornerRadius="20"
            Padding="0"
            Margin="12"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WindowScale" ScaleX="0.95" ScaleY="0.95"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="44" ShadowDepth="12" Opacity="0.85"/>
        </Border.Effect>

        <Grid>
            <!-- Top Ambient Gradient Accent Line -->
            <Border Height="3" VerticalAlignment="Top" CornerRadius="20,20,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#6366F1" Offset="0"/>
                        <GradientStop Color="#8B5CF6" Offset="0.35"/>
                        <GradientStop Color="#EC4899" Offset="0.7"/>
                        <GradientStop Color="#10B981" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Content Layout -->
            <Grid Margin="26,22,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Header -->
                    <RowDefinition Height="Auto"/>   <!-- Shortcuts Section -->
                    <RowDefinition Height="Auto"/>   <!-- Test Scratchpad -->
                    <RowDefinition Height="Auto"/>   <!-- System Tray Guidance -->
                    <RowDefinition Height="*"/>      <!-- Spacer -->
                    <RowDefinition Height="Auto"/>   <!-- Footer Actions -->
                </Grid.RowDefinitions>

                <!-- ══ 1. Header ═════════════════════════════════════════════════════ -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Glowing App Icon -->
                    <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Ellipse Width="46" Height="46">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F46E5" Offset="0"/>
                                    <GradientStop Color="#9333EA" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#6366F1" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="🎙"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="VACANAM"
                                       Foreground="#FFFFFF"
                                       FontWeight="Bold"
                                       FontSize="21"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="StatusBadge" Background="#10B981" CornerRadius="12" Padding="9,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#FFFFFF" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TxtBadgeText" Text="READY" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1F1635" BorderBrush="#4A2885" BorderThickness="1" CornerRadius="12" Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="✨ AI ASSISTANT" Foreground="#D8B4FE" FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtSubtitle"
                                   Text="Instant On-Device Voice Typing &amp; Desktop AI Assistant for Windows"
                                   Foreground="#94A3B8"
                                   FontSize="12.5"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Engine Pills -->
                    <Border Grid.Column="2"
                            Background="#161926"
                            BorderBrush="#2B324B"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,7"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtWhisperEngine" Text="⚡ Whisper STT" Foreground="#34D399" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock Text="  •  " Foreground="#475569" FontSize="11.5"/>
                            <TextBlock x:Name="TxtLlmEngine" Text="🧠 Local LLM" Foreground="#C084FC" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══ 2. Shortcuts Section ═══════════════════════════════════════════ -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <!-- Row 1: Voice Typing / Dictation -->
                    <Border Background="#141724"
                            BorderBrush="#262F46"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,11"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="#1B2338" BorderBrush="#2D3B60" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="🎙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHotkeyTitle" Text="Voice Typing / Dictation"
                                           Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtHotkeyDesc"
                                           Text="Hold to transcribe speech directly into any focused application (Word, Slack, VS Code, Browser)"
                                           Foreground="#94A3B8" FontSize="11.5" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <Border Background="#1F2536" BorderBrush="#3B4664" BorderThickness="1,1,1,2.5" CornerRadius="6" Padding="12,4" MinWidth="46">
                                    <TextBlock Text="Ctrl" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="+" Foreground="#64748B" FontSize="13" FontWeight="Bold" Margin="6,0" VerticalAlignment="Center"/>
                                <Border Background="#132620" BorderBrush="#10B981" BorderThickness="1,1,1,2.5" CornerRadius="6" Padding="14,4" MinWidth="60">
                                    <TextBlock Text="Space" Foreground="#34D399" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: Ask AI & Transform -->
                    <Border Background="#181526"
                            BorderBrush="#362850"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9" Background="#261C3D" BorderBrush="#4C3478" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="🪄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Ask AI &amp; Transform"
                                           Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Highlight text to reply/rewrite, or hold to prompt the local AI directly at cursor"
                                           Foreground="#C4B5FD" FontSize="11.5" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <Border Background="#261C3B" BorderBrush="#4A346E" BorderThickness="1,1,1,2.5" CornerRadius="6" Padding="12,4" MinWidth="46">
                                    <TextBlock Text="Shift" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="+" Foreground="#7C6B98" FontSize="13" FontWeight="Bold" Margin="6,0" VerticalAlignment="Center"/>
                                <Border Background="#24143A" BorderBrush="#A855F7" BorderThickness="1,1,1,2.5" CornerRadius="6" Padding="14,4" MinWidth="60">
                                    <TextBlock Text="Space" Foreground="#D8B4FE" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ══ 3. Interactive Test Scratchpad ═════════════════════════════════ -->
                <Border Grid.Row="2"
                        Background="#131624"
                        BorderBrush="#252E46"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14,12"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Scratchpad Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🧪" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Test Scratchpad" Foreground="#38BDF8" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                <TextBlock Text=" — Click inside the box, hold " Foreground="#94A3B8" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Ctrl + Space" Foreground="#34D399" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text=", and speak a test sentence:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Content="Clear"
                                    Background="Transparent"
                                    Foreground="#64748B"
                                    BorderThickness="0"
                                    FontSize="11"
                                    Cursor="Hand"
                                    Click="BtnClearScratchpad_Click"/>
                        </Grid>

                        <!-- Focusable Test TextBox -->
                        <TextBox Grid.Row="1"
                                 x:Name="TxtTestScratchpad"
                                 Height="52"
                                 Background="#181D2C"
                                 BorderBrush="#2E3954"
                                 BorderThickness="1"
                                 Foreground="#FFFFFF"
                                 CaretBrush="#6366F1"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="False"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="10,8"
                                 GotFocus="TxtTestScratchpad_GotFocus">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- ══ 4. System Tray Guidance Callout ════════════════════════════════ -->
                <Border Grid.Row="3"
                        Background="#14192A"
                        BorderBrush="#202A44"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,9"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="💡" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="11.5" LineHeight="16">
                            <Run Text="Where does Vacanam live? " Foreground="#E2E8F0" FontWeight="SemiBold"/>
                            <Run Text="Vacanam runs in the background in your " Foreground="#94A3B8"/>
                            <Run Text="system tray" Foreground="#60A5FA" FontWeight="SemiBold"/>
                            <Run Text=" (bottom-right near your clock 🎙). Right-click the icon anytime for Settings, Models, and Transcript History." Foreground="#94A3B8"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ══ 5. Footer Actions ══════════════════════════════════════════════ -->
                <Grid Grid.Row="5" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Startup Checkbox & Privacy -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkShowOnStartup"
                                  Content="Show this Quick Start guide on Windows startup"
                                  Foreground="#94A3B8"
                                  FontSize="11.5"
                                  IsChecked="True"/>
                        <TextBlock Text="🔒 100% Local &amp; Private • On-Device AI • Zero Cloud Telemetry"
                                   Foreground="#34D399"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Right: Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnSettings"
                                Click="BtnSettings_Click"
                                Cursor="Hand"
                                Background="#181D2C"
                                BorderBrush="#333E5E"
                                BorderThickness="1"
                                Foreground="#CBD5E1"
                                FontWeight="SemiBold"
                                FontSize="12.5"
                                Padding="14,8"
                                Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Go to Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <Button x:Name="BtnStart"
                                Click="BtnStart_Click"
                                Cursor="Hand"
                                Background="#4F46E5"
                                BorderBrush="#6366F1"
                                BorderThickness="1"
                                Foreground="#FFFFFF"
                                FontWeight="Bold"
                                FontSize="13"
                                Padding="18,9">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Start Using Vacanam"/>
                                    <TextBlock Text=" ➔" FontWeight="Bold"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
