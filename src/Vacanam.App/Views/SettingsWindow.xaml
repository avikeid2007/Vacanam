<Window x:Class="Vacanam.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vacanam.App.ViewModels"
        Title="Vacanam — Settings"
        Width="780" Height="580"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1A1A24"
        Foreground="#F1F1F8"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="13"
        BorderBrush="#2A2A3D"
        BorderThickness="1">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Resources/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>     <!-- Header -->
            <RowDefinition Height="*"/>      <!-- Content -->
            <RowDefinition Height="56"/>     <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══ Header ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0F0F14" BorderBrush="#2A2A3D" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                <Ellipse Width="10" Height="10" Margin="0,0,10,0">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="#4F46E5" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="Vacanam"
                           Foreground="#6366F1"
                           FontWeight="SemiBold"
                           FontSize="15"
                           VerticalAlignment="Center"/>
                <TextBlock Text=" Settings"
                           Foreground="#A0A0BC"
                           FontSize="15"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══ Main Content (Sidebar + Tab panels) ═══════════════════════════════ -->
        <TabControl Grid.Row="1"
                    x:Name="SettingsTabControl"
                    TabStripPlacement="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>   <!-- Sidebar nav -->
                            <ColumnDefinition Width="*"/>     <!-- Panel content -->
                        </Grid.ColumnDefinitions>

                        <!-- Sidebar Background -->
                        <Border Grid.Column="0" Background="#0F0F14" BorderBrush="#2A2A3D" BorderThickness="0,0,1,0">
                            <StackPanel Margin="6,12">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True"/>
                            </StackPanel>
                        </Border>

                        <!-- Content Area -->
                        <Border Grid.Column="1" Background="#1A1A24">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="0"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- General -->
            <TabItem Style="{StaticResource SettingsTabItemStyle}" Header="⚙  General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HeadingStyle}" Text="General" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Startup and notification preferences" Margin="0,0,0,24"/>

                        <CheckBox Style="{StaticResource VacanamCheckBoxStyle}"
                                  IsChecked="{Binding StartWithWindows}"
                                  Content="Start Vacanam when Windows starts"
                                  Margin="0,0,0,16"/>

                        <CheckBox Style="{StaticResource VacanamCheckBoxStyle}"
                                  IsChecked="{Binding ShowTrayNotifications}"
                                  Content="Show balloon notifications in tray"
                                  Margin="0,0,0,24"/>

                        <Separator Style="{StaticResource SectionSeparatorStyle}"/>

                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Default Processing Mode" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource VacanamComboBoxStyle}"
                                  ItemsSource="{Binding AvailableModes}"
                                  SelectedItem="{Binding DefaultMode}"
                                  Width="220"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Fast: no LLM. AI: grammar correction. Command: voice actions."
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <Separator Style="{StaticResource SectionSeparatorStyle}"/>

                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Diagnostics &amp; Logs" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Content="📁  Open Log Folder"
                                Command="{Binding OpenLogFolderCommand}"
                                Width="180"
                                HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Opens %LOCALAPPDATA%\Vacanam\Logs in Windows Explorer for troubleshooting."
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hotkeys -->
            <TabItem Style="{StaticResource SettingsTabItemStyle}" Header="⌨  Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HeadingStyle}" Text="Hotkeys" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Global keyboard shortcut configuration" Margin="0,0,0,24"/>

                        <TextBlock Style="{StaticResource BodyStyle}" Text="Push-to-Talk Shortcut" Margin="0,0,0,8"/>
                        <Border Background="#242433" CornerRadius="8" Padding="16,12" Width="240" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding HotkeyDisplayText}"
                                       Foreground="#6366F1"
                                       FontFamily="Consolas, monospace"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Hotkey customisation will be available in a future update."
                                   Margin="0,8,0,24"/>

                        <Separator Style="{StaticResource SectionSeparatorStyle}"/>

                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Recording Mode" Margin="0,0,0,8"/>
                        <CheckBox Style="{StaticResource VacanamCheckBoxStyle}"
                                  IsChecked="{Binding PushToTalk}"
                                  Content="Push-to-talk (hold key to record, release to process)"
                                  Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Unchecked = Toggle mode: press once to start, press again to stop."
                                   Margin="20,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Audio -->
            <TabItem Style="{StaticResource SettingsTabItemStyle}" Header="🎙  Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HeadingStyle}" Text="Audio" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Microphone and voice detection settings" Margin="0,0,0,24"/>

                        <TextBlock Style="{StaticResource BodyStyle}" Text="Microphone Device" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource VacanamComboBoxStyle}"
                                  Width="320"
                                  HorizontalAlignment="Left"
                                  IsEnabled="False">
                            <ComboBoxItem Content="System Default Microphone"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Device selection will be available after audio integration (Phase 3)."
                                   Margin="0,6,0,24"/>

                        <Separator Style="{StaticResource SectionSeparatorStyle}"/>

                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Microphone Input Level" Margin="0,0,0,12"/>

                        <CheckBox Style="{StaticResource VacanamCheckBoxStyle}"
                                  IsChecked="{Binding IsMicMuted}"
                                  Content="Mute Microphone 🔇"
                                  Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource BodyStyle}" Text="Microphone Volume: "/>
                            <TextBlock Style="{StaticResource BodyStyle}"
                                       Text="{Binding MicVolume, StringFormat={}{0:F0}%}"
                                       Foreground="#6366F1"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding MicVolume}"
                                Width="280" HorizontalAlignment="Left"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Adjust active Windows microphone input volume directly (vacanam alerts if &lt; 30%)."
                                   Margin="0,0,0,24"/>

                        <Separator Style="{StaticResource SectionSeparatorStyle}"/>

                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Voice Activity Detection (VAD)" Margin="0,0,0,8"/>
                        <CheckBox Style="{StaticResource VacanamCheckBoxStyle}"
                                  IsChecked="{Binding EnableVad}"
                                  Content="Enable VAD — automatically trim silence"
                                  Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource BodyStyle}" Text="Silence Threshold" Margin="0,0,0,8"/>
                        <Slider Minimum="0.005" Maximum="0.1"
                                Value="{Binding VadThreshold}"
                                Width="240" HorizontalAlignment="Left"
                                IsEnabled="{Binding EnableVad}"/>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Lower = more sensitive (picks up quieter speech). Higher = less noise."
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Speech -->
            <TabItem Style="{StaticResource SettingsTabItemStyle}" Header="🗣  Speech">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HeadingStyle}" Text="Speech Recognition" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Whisper model and inference settings" Margin="0,0,0,24"/>

                        <TextBlock Style="{StaticResource BodyStyle}" Text="Whisper Model Selection" Margin="0,0,0,12"/>

                        <!-- Model cards -->
                        <ItemsControl ItemsSource="{Binding WhisperModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#242433"
                                            BorderBrush="{Binding IsActive, Converter={StaticResource BoolToVis}, FallbackValue='#2A2A3D'}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,12"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="#F1F1F8"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"/>
                                                    
                                                    <!-- Status Badge -->
                                                    <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Background="#1E1E2E" BorderBrush="#2A2A3D" BorderThickness="1">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="#837AF9"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="#6B6B8A"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Size}"
                                                       Foreground="#A0A0BC"
                                                       FontSize="12"
                                                       Margin="16,0"
                                                       VerticalAlignment="Center"/>

                                            <!-- Actions: Select / Download -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Select"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Padding="12,6"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.SelectWhisperModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}"/>
                                                
                                                <Button Content="Download"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="12,6"
                                                        IsEnabled="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.DownloadWhisperModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Style="{StaticResource SectionSeparatorStyle}"/>

                        <TextBlock Style="{StaticResource BodyStyle}" Text="Recognition Language" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource VacanamComboBoxStyle}"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="DisplayName"
                                  Width="280"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Select spoken language for transcription (Default: English). Auto-Detect dynamically identifies language."
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>

                        <Separator Style="{StaticResource SectionSeparatorStyle}"/>

                        <TextBlock Style="{StaticResource BodyStyle}" Text="Inference Device" Margin="0,0,0,8"/>
                        <ComboBox Style="{StaticResource VacanamComboBoxStyle}"
                                  ItemsSource="{Binding WhisperDevices}"
                                  SelectedItem="{Binding WhisperDevice}"
                                  Width="180"
                                  HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Auto: use GPU if available, otherwise CPU."
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- AI -->
            <TabItem Style="{StaticResource SettingsTabItemStyle}" Header="🤖  AI">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HeadingStyle}" Text="AI Processing" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Local LLM grammar correction and text enhancement" Margin="0,0,0,16"/>

                        <Border Background="#1A1A24"
                                BorderBrush="#2A2A3D"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,0,0,20">
                            <TextBlock Foreground="#10B981"
                                       FontSize="12"
                                       Text="🔒  All AI processing runs 100% locally. No data leaves your device."
                                       TextWrapping="Wrap"/>
                        </Border>

                        <CheckBox Style="{StaticResource VacanamCheckBoxStyle}"
                                  IsChecked="{Binding AiEnabled}"
                                  IsEnabled="{Binding CanEnableAi}"
                                  Content="Enable AI text enhancement"
                                  Margin="0,0,0,6"/>

                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="{Binding AiStatusCaption}"
                                   Margin="0,0,0,20"/>

                        <Separator Style="{StaticResource SectionSeparatorStyle}"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SubheadingStyle}" Text="System Prompt / Grammar Polish Rules" VerticalAlignment="Center"/>
                            <Button Content="Reset to Default"
                                    Command="{Binding ResetSystemPromptCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Padding="10,4"
                                    FontSize="11"/>
                        </Grid>

                        <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="90"
                                 MaxHeight="160"
                                 Background="#1A1A24"
                                 Foreground="#F1F1F8"
                                 BorderBrush="#2A2A3D"
                                 BorderThickness="1"
                                 Padding="12,10"
                                 FontFamily="Consolas, monospace"
                                 FontSize="12"
                                 Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Customize instructions for the local LLM text refinement engine."
                                   Margin="0,0,0,20"/>

                        <Separator Style="{StaticResource SectionSeparatorStyle}"/>

                        <TextBlock Style="{StaticResource BodyStyle}" Text="Sub-400MB Local LLM Models (LLamaSharp CPU)" Margin="0,0,0,12"/>

                        <!-- LLM model cards -->
                        <ItemsControl ItemsSource="{Binding LlmModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#242433"
                                            BorderBrush="#2A2A3D"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="#F1F1F8"
                                                               FontWeight="SemiBold"/>
                                                    <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Background="#1E1E2E" BorderBrush="#2A2A3D" BorderThickness="1">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Foreground="#837AF9"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="#6B6B8A"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                                <TextBlock Text="{Binding Size}"
                                                           Foreground="#A0A0BC"
                                                           FontSize="11"/>
                                                <TextBlock Text="{Binding VramRequired}"
                                                           Foreground="#6B6B8A"
                                                           FontSize="11"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Select"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Padding="12,6"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.SelectLlmModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding FileName}"/>

                                                <Button Content="Download"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="12,6"
                                                        Command="{Binding DataContext.DownloadLlmModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding FileName}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Commands & Snippets -->
            <TabItem Style="{StaticResource SettingsTabItemStyle}" Header="⚡  Commands">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HeadingStyle}" Text="Voice Commands &amp; Smart Punctuation" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Control your PC hands-free and expand custom voice macros" Margin="0,0,0,24"/>

                        <CheckBox Style="{StaticResource VacanamCheckBoxStyle}"
                                  IsChecked="{Binding VoiceCommandsEnabled}"
                                  Content="Enable Standalone Voice Action Commands"
                                  Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Detects action commands like 'select all', 'copy that', 'undo that', 'press enter', 'save file', 'lock screen' and executes them instantly."
                                   Margin="28,0,0,16"/>

                        <CheckBox Style="{StaticResource VacanamCheckBoxStyle}"
                                  IsChecked="{Binding EnableSmartPunctuation}"
                                  Content="Enable Smart Verbal Punctuation &amp; Emojis"
                                  Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Converts spoken punctuation ('comma', 'question mark', 'new line', 'smiley face') into formatted symbols with auto-capitalization."
                                   Margin="28,0,0,24"/>

                        <Separator Style="{StaticResource SectionSeparatorStyle}"/>

                        <!-- Built-in Commands Reference -->
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Built-in Voice Commands Cheat Sheet" Margin="0,0,0,12"/>
                        <Border Background="#0F0F14" BorderBrush="#2A2A3D" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="• 'select all' → Ctrl + A" Foreground="#C5C5DE" Margin="0,2"/>
                                    <TextBlock Text="• 'copy that' / 'copy' → Ctrl + C" Foreground="#C5C5DE" Margin="0,2"/>
                                    <TextBlock Text="• 'paste that' / 'paste' → Ctrl + V" Foreground="#C5C5DE" Margin="0,2"/>
                                    <TextBlock Text="• 'undo that' / 'undo' → Ctrl + Z" Foreground="#C5C5DE" Margin="0,2"/>
                                    <TextBlock Text="• 'redo that' / 'redo' → Ctrl + Y" Foreground="#C5C5DE" Margin="0,2"/>
                                    <TextBlock Text="• 'save document' / 'save' → Ctrl + S" Foreground="#C5C5DE" Margin="0,2"/>
                                    <TextBlock Text="• 'switch window' → Alt + Tab" Foreground="#C5C5DE" Margin="0,2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="• 'press enter' → Enter key" Foreground="#C5C5DE" Margin="0,2"/>
                                    <TextBlock Text="• 'press tab' → Tab key" Foreground="#C5C5DE" Margin="0,2"/>
                                    <TextBlock Text="• 'press escape' → Escape key" Foreground="#C5C5DE" Margin="0,2"/>
                                    <TextBlock Text="• 'delete line' → Erase line" Foreground="#C5C5DE" Margin="0,2"/>
                                    <TextBlock Text="• 'delete word' → Backspace word" Foreground="#C5C5DE" Margin="0,2"/>
                                    <TextBlock Text="• 'close window' → Alt + F4" Foreground="#C5C5DE" Margin="0,2"/>
                                    <TextBlock Text="• 'lock computer' → Lock Windows" Foreground="#C5C5DE" Margin="0,2"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Separator Style="{StaticResource SectionSeparatorStyle}"/>

                        <!-- Custom Voice Snippets -->
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Custom Voice Snippets / Macros" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Say a trigger phrase (e.g. 'insert signature') to paste pre-configured templates. Dynamic tags: {DATE}, {TIME}, {DATETIME}."
                                   Margin="0,0,0,16"/>

                        <!-- Add Snippet Inputs -->
                        <Border Background="#0F0F14" BorderBrush="#2A2A3D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Trigger Phrase:" Foreground="#A0A0BC" VerticalAlignment="Center" Width="110"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewSnippetTrigger, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#1A1A24" Foreground="#F1F1F8" BorderBrush="#2A2A3D" BorderThickness="1" Padding="8,6"
                                             FontSize="13"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Template Text:" Foreground="#A0A0BC" VerticalAlignment="Top" Margin="0,6,0,0" Width="110"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewSnippetExpansion, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Height="70"
                                             Background="#1A1A24" Foreground="#F1F1F8" BorderBrush="#2A2A3D" BorderThickness="1" Padding="8,6"
                                             FontSize="13"/>
                                </Grid>

                                <Button Grid.Row="2"
                                        Content="+ Add Voice Snippet"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Padding="16,6"
                                        Command="{Binding AddSnippetCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Snippets List -->
                        <ItemsControl ItemsSource="{Binding CustomSnippets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F0F14"
                                            BorderBrush="#2A2A3D"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14,10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="🗣 Trigger" Foreground="#6366F1" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding TriggerPhrase}" Foreground="#F1F1F8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="📝 Expansion" Foreground="#A0A0BC" FontSize="11"/>
                                                <TextBlock Text="{Binding ExpansionText}" Foreground="#C5C5DE" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="Delete"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Padding="10,4"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DeleteSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Privacy -->
            <TabItem Style="{StaticResource SettingsTabItemStyle}" Header="🔒  Privacy">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HeadingStyle}" Text="Privacy" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Data storage and local-first guarantees" Margin="0,0,0,24"/>

                        <Border Background="#0A1A0F"
                                BorderBrush="#10B981"
                                BorderThickness="0,0,0,0"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Vacanam Privacy Principles"
                                           Foreground="#10B981"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBlock Foreground="#A0A0BC" FontSize="12" TextWrapping="Wrap"
                                           Text="• 100% local processing — no audio or text ever leaves your device&#x0a;• No cloud APIs, no telemetry, no analytics&#x0a;• Audio is never written to disk&#x0a;• Transcript history is opt-in and stored only on your device&#x0a;• Clipboard contents are never logged"/>
                            </StackPanel>
                        </Border>

                        <Separator Style="{StaticResource SectionSeparatorStyle}"/>

                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Transcript History" Margin="0,0,0,8"/>
                        <CheckBox Style="{StaticResource VacanamCheckBoxStyle}"
                                  IsChecked="{Binding SaveHistory}"
                                  Content="Save transcript history (opt-in)"
                                  Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Stores: timestamp, raw transcript, final text, target app. Never stores audio."
                                   Margin="20,0,0,16" TextWrapping="Wrap"/>

                        <TextBlock Style="{StaticResource BodyStyle}" Text="Maximum History Entries" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider Minimum="50" Maximum="5000"
                                    Value="{Binding MaxHistoryEntries}"
                                    Width="200"
                                    IsEnabled="{Binding SaveHistory}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MaxHistoryEntries}"
                                       Foreground="#A0A0BC"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- History -->
            <TabItem Style="{StaticResource SettingsTabItemStyle}" Header="📜  History">
                <Grid Margin="32,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Title & Subtitle -->
                        <RowDefinition Height="Auto"/>   <!-- Search bar & Clear button -->
                        <RowDefinition Height="*"/>      <!-- Records List -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource HeadingStyle}" Text="Transcript History" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Search and manage your saved local transcripts (SQLite)" Margin="0,0,0,16"/>
                    </StackPanel>

                    <!-- Search Bar + Refresh / Clear All Buttons -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding HistorySearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#1A1A24"
                                 Foreground="#F1F1F8"
                                 BorderBrush="#2A2A3D"
                                 BorderThickness="1"
                                 Padding="12,8"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>

                        <Button Grid.Column="1"
                                Content="Refresh"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding RefreshHistoryCommand}"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Content="Clear All History"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ClearHistoryCommand}"
                                Foreground="#EF4444"
                                Padding="12,6"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Records ItemsControl -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HistoryRecords}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#242433"
                                            BorderBrush="#2A2A3D"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,12"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <!-- Top Metadata line -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Background="#1E1E2E" BorderBrush="#2A2A3D" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding TargetApp}" Foreground="#837AF9" FontSize="11" FontWeight="Bold"/>
                                                    </Border>

                                                    <TextBlock Text="{Binding TimestampUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="#6B6B8A" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                    <TextBlock Text="{Binding DurationSeconds, StringFormat='{}{0:F1}s'}" Foreground="#6B6B8A" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Final Text -->
                                                <TextBlock Text="{Binding FinalText}" Foreground="#F1F1F8" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Actions: Copy & Delete -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Content="Copy"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.CopyHistoryTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding FinalText}"
                                                        Padding="10,4"
                                                        Margin="0,0,6,0"/>

                                                <Button Content="✕"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.DeleteHistoryRecordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}"
                                                        Foreground="#EF4444"
                                                        Padding="8,4"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ══ Footer ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0F0F14" BorderBrush="#2A2A3D" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#6366F1"
                           FontWeight="Medium"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Reset Defaults"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding ResetToDefaultsCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Cancel"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Save Settings"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
