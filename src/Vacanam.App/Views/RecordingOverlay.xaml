<Window x:Class="Vacanam.App.Views.RecordingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vacanam.App.ViewModels"
        Title="VacanamOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <!-- Bottom-center positioning done in code-behind -->

    <Grid>
        <!-- Glassmorphism pill container -->
        <Border x:Name="PillContainer"
                Background="#CC1A1A24"
                CornerRadius="24"
                Padding="20,12,20,12"
                Margin="0">
            <Border.Effect>
                <DropShadowEffect Color="#6366F1"
                                  BlurRadius="20"
                                  ShadowDepth="0"
                                  Opacity="0.3"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Animated state indicator ring -->
                <Grid Width="20" Height="20" Margin="0,0,10,0">
                    <Ellipse x:Name="OuterRing"
                             Stroke="{StaticResource RecordingBrush}"
                             StrokeThickness="1.5"
                             Opacity="0.3"/>
                    <Ellipse x:Name="InnerDot"
                             Fill="{StaticResource RecordingBrush}"
                             Width="10" Height="10"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="PulseScale" CenterX="5" CenterY="5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <!-- Status label -->
                <TextBlock x:Name="StatusLabel"
                           Text="{Binding StatusLabel}"
                           Foreground="#F1F1F8"
                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                           FontSize="13"
                           FontWeight="Medium"
                           VerticalAlignment="Center"/>

            </StackPanel>
        </Border>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="PulseScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.9" To="1.1"
                                     Duration="0:0:0.8"/>
                    <DoubleAnimation Storyboard.TargetName="PulseScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.9" To="1.1"
                                     Duration="0:0:0.8"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

</Window>
