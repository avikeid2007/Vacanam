<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════
         Vacanam Design Tokens — Color Palette
         Primary: Indigo/Violet brand    Secondary: Slate grays
         Accent: Rose red for recording  Success: Emerald
    ════════════════════════════════════════════════════════════════════════════ -->

    <!-- Brand Primaries -->
    <Color x:Key="Brand50Color">#F0EFFF</Color>
    <Color x:Key="Brand100Color">#E0DFFE</Color>
    <Color x:Key="Brand200Color">#C4C2FD</Color>
    <Color x:Key="Brand300Color">#A39EFC</Color>
    <Color x:Key="Brand400Color">#837AF9</Color>
    <Color x:Key="Brand500Color">#6366F1</Color>
    <Color x:Key="Brand600Color">#4F46E5</Color>
    <Color x:Key="Brand700Color">#4338CA</Color>
    <Color x:Key="Brand800Color">#3730A3</Color>
    <Color x:Key="Brand900Color">#312E81</Color>

    <!-- Recording / Error Reds -->
    <Color x:Key="RecordingColor">#DC2626</Color>
    <Color x:Key="RecordingLightColor">#FEE2E2</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>

    <!-- Success Greens -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessLightColor">#D1FAE5</Color>

    <!-- Warning Ambers -->
    <Color x:Key="WarningColor">#F59E0B</Color>

    <!-- Surface / Background Grays (Dark theme) -->
    <Color x:Key="Surface900Color">#0F0F14</Color>
    <Color x:Key="Surface800Color">#1A1A24</Color>
    <Color x:Key="Surface700Color">#242433</Color>
    <Color x:Key="Surface600Color">#2E2E42</Color>
    <Color x:Key="Surface500Color">#3D3D57</Color>

    <!-- Text on Dark -->
    <Color x:Key="TextPrimaryColor">#F1F1F8</Color>
    <Color x:Key="TextSecondaryColor">#A0A0BC</Color>
    <Color x:Key="TextTertiaryColor">#6B6B8A</Color>
    <Color x:Key="TextDisabledColor">#4A4A63</Color>

    <!-- Border -->
    <Color x:Key="BorderColor">#2A2A3D</Color>
    <Color x:Key="BorderFocusColor">#6366F1</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource Brand600Color}" />
    <SolidColorBrush x:Key="BrandLightBrush" Color="{StaticResource Brand400Color}" />
    <SolidColorBrush x:Key="RecordingBrush" Color="{StaticResource RecordingColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <SolidColorBrush x:Key="Surface900Brush" Color="{StaticResource Surface900Color}" />
    <SolidColorBrush x:Key="Surface800Brush" Color="{StaticResource Surface800Color}" />
    <SolidColorBrush x:Key="Surface700Brush" Color="{StaticResource Surface700Color}" />
    <SolidColorBrush x:Key="Surface600Brush" Color="{StaticResource Surface600Color}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Brand500Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Brand700Color}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Surface800Color}" Offset="0"/>
        <GradientStop Color="{StaticResource Surface900Color}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
